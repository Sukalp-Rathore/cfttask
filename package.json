{
  "name": "chat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticated chat API using PostgreSQL and Firebase Firestore",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
